APP_NAME="TS Confecções"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: sqlite | Produção (Render): pgsql
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=confeccao
# DB_USERNAME=
# DB_PASSWORD=
# DATABASE_URL=   # Render injeta automaticamente ao vincular o Postgres

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync = e-mails imediatos (recomendado no plano free do Render)
QUEUE_CONNECTION=sync

CACHE_STORE=database

# --- Gmail (SMTP) — use Senha de app: https://myaccount.google.com/apppasswords ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_de_app
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=seu_email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# Alertas de estoque (padrão se o item não tiver quantidade_minima)
ESTOQUE_LIMITE_BAIXO=10

# Cópia opcional de todos os e-mails para um endereço administrativo
# NOTIFICACAO_EMAIL_ADMIN=admin@gmail.com

VITE_APP_NAME="${APP_NAME}"
